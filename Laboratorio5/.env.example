# Copie para .env (que NAO e versionado: .env esta no .gitignore) e preencha.
#   cp .env.example .env && chmod 600 .env
# O harness e o harness/check-env leem este arquivo; variaveis ja exportadas no terminal tem prioridade.

# Credencial do Claude Code: use UMA das duas. Nunca coloque em arquivo versionado nem no chat.
# Assinatura (claude setup-token): sem cobranca por token, vale o limite do plano.
CLAUDE_CODE_OAUTH_TOKEN=
# Ou chave de API (cobranca por token):
# ANTHROPIC_API_KEY=

# Modelo fixado do experimento e atualizacao automatica desativada.
ANTHROPIC_MODEL=claude-sonnet-5-5
DISABLE_AUTOUPDATER=1

# Opcionais (limites ainda nao decididos pelo grupo; ver docs/s02/protocolo-congelado.md):
# HARNESS_TIMEOUT_S=1800
# HARNESS_MAX_TURNS=
# HARNESS_MAX_BUDGET_USD=
